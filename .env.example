# ==========================================
# StayManage Environment Configuration
# ==========================================

# Application Environment (development, production, test)
NODE_ENV=development
PORT=3000

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (enabled by default for zero-friction exploration without remote db)
# When set to 'true', StayManage loads rich pre-seeded Indian PG data ("StayManage Demo")
# with realistic properties, residents, rent records, security deposits, and role switching.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Credentials (Required for remote PostgreSQL production deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Database Connection String (for Prisma/Drizzle/migration scripts)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Application Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
